<?xml version="1.0" encoding="utf-8"?>
<!-- TV-Banner 320x180: schwarz-gelb kariert angedeutet -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#15151E" />
        </shape>
    </item>
    <item android:left="20dp" android:top="70dp" android:right="20dp" android:bottom="70dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFC800" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="20dp" android:top="20dp" android:right="250dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#E10600" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
